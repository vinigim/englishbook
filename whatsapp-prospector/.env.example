# ============================================================
# WhatsApp Cloud API (Meta) — credenciais oficiais
# ============================================================
# Obtenha em: https://developers.facebook.com/  ->  seu App
# -> WhatsApp -> API Setup

# Token de acesso permanente (System User Token). O token temporário
# de 24h também funciona para testes, mas expira.
WHATSAPP_ACCESS_TOKEN=

# ID do número de telefone (Phone number ID) — NÃO é o número em si.
WHATSAPP_PHONE_NUMBER_ID=

# ID da conta do WhatsApp Business (WABA). Usado para listar templates.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Versão da Graph API (opcional). Padrão: v21.0
WHATSAPP_API_VERSION=v21.0

# ============================================================
# Controle de ritmo do disparo (opcional)
# ============================================================
# Intervalo mínimo entre mensagens, em milissegundos. Padrão: 4000 (4s).
# Aumente para reduzir risco de bloqueio de qualidade em prospecção.
SEND_DELAY_MS=4000
