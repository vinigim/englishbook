# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Quem pode entrar (separados por vírgula). Obrigatório se o projeto Supabase
# for compartilhado com outro sistema.
EMAILS_PERMITIDOS=

# Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Gmail via IMAP: conta com verificação em 2 etapas + "senha de app"
# (myaccount.google.com/apppasswords). Deixe em branco para desligar a fonte.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# A Vercel envia "Authorization: Bearer $CRON_SECRET" no cron diário.
CRON_SECRET=
