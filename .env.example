# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Usada pelas rotas do Radar de Leads (webhook, importação, análise).
# Sem ela o site abre normalmente e só essas rotas quebram, em produção.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Radar de Leads (WhatsApp + IA) — /derma-lux/leads
# ----------------------------------------------------------------------------

# "evolution" usa a Evolution API de verdade; "mock" lê as fixtures em
# src/lib/whatsapp/fixtures/ e não toca em número nenhum (use em dev).
WHATSAPP_PROVIDER=mock

# Evolution API (servidor próprio, sempre ligado — a Vercel é serverless e não
# sustenta o socket do WhatsApp).
EVOLUTION_API_URL=https://evolution.seudominio.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=luxderma

# Segredo do webhook. A URL é pública e escreve no banco com a service role,
# então gere algo longo (32+ caracteres) e configure o mesmo valor na Evolution:
#   https://<dominio>/api/whatsapp/webhook?s=<este-segredo>
WHATSAPP_WEBHOOK_SECRET=gere-uma-string-aleatoria-grande

# Análise dos leads. Sem esta chave o painel funciona, mas não gera sugestões.
ANTHROPIC_API_KEY=sk-ant-...
